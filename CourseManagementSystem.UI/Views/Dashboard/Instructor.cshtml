@model List<CourseViewModel>
@{
    ViewData["Title"] = "Instructor Dashboard";
    var user = ViewBag.User as UserViewModel;
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2>Welcome, @user?.FirstName! (Instructor)</h2>
        <p class="text-muted">Manage your courses and student enrollments here.</p>
    </div>
    <div class="col-md-4 text-end">
        <a asp-controller="Course" asp-action="Create" class="btn btn-success">+ Create New Course</a>
    </div>
</div>

<div class="row">
    @if (Model.Any())
    {
        @foreach (var course in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-success">
                    @if (!string.IsNullOrEmpty(course.CourseImageUrl))
                    {
                        <img src="@course.CourseImageUrl" class="card-img-top" alt="@course.Name" style="height: 150px; object-fit: cover;">
                    }
                    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">@course.Name</h5>
                        <span class="badge bg-light text-success">@course.EnrolledCount Enrolled</span>
                    </div>
                    <div class="card-body">
                        <h6 class="card-subtitle mb-2 text-muted">@course.Code</h6>
                        <p class="card-text">Capacity: @course.Capacity students</p>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-controller="Course" asp-action="Details" asp-route-id="@course.Id" class="btn btn-outline-success btn-sm flex-grow-1">Manage</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="card shadow-sm p-5 border-success">
                <h4>You haven't created any courses yet.</h4>
                <p>Start by creating your first course to share your knowledge!</p>
                <div class="mt-3">
                    <a href="#" class="btn btn-success disabled">Create New Course</a>
                </div>
            </div>
        </div>
    }
</div>
