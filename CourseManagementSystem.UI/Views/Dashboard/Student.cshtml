@model List<CourseViewModel>
@{
    ViewData["Title"] = "Student Dashboard";
    var user = ViewBag.User as UserViewModel;
}

<div class="row mb-4">
    <div class="col-12">
        <h2>Welcome, @user?.FirstName! (Student)</h2>
        <p class="text-muted">Here are the courses you are currently enrolled in.</p>
    </div>
</div>

<div class="row">
    @if (Model.Any())
    {
        @foreach (var course in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-primary">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">@course.Name</h5>
                    </div>
                    <div class="card-body">
                        <h6 class="card-subtitle mb-2 text-muted">@course.Code</h6>
                        <p class="card-text">Instructor: @course.InstructorName</p>
                        <p class="card-text">
                            <small>Starts: @course.StartDate</small><br/>
                            <small>Ends: @course.EndDate</small>
                        </p>
                    </div>
                    <div class="card-footer">
                        <a href="#" class="btn btn-outline-primary w-100 disabled">Course Details</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="card shadow-sm p-5">
                <h4>You are not enrolled in any courses yet.</h4>
                <p>Browse our catalog and start your learning journey!</p>
                <div class="mt-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Browse Courses</a>
                </div>
            </div>
        </div>
    }
</div>
