@model CreateCourseViewModel
@{
    ViewData["Title"] = "Create Course";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h3 class="mb-0">Create New Course</h3>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-floating mb-3">
                                <input asp-for="Name" class="form-control" placeholder="Course Name" />
                                <label asp-for="Name"></label>
                                <span asp-for="Name" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating mb-3">
                                <input asp-for="Code" class="form-control" placeholder="CS101" />
                                <label asp-for="Code"></label>
                                <span asp-for="Code" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <textarea asp-for="Description" class="form-control" placeholder="Description" style="height: 100px"></textarea>
                        <label asp-for="Description"></label>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-floating mb-3">
                                <input asp-for="Capacity" class="form-control" />
                                <label asp-for="Capacity"></label>
                                <span asp-for="Capacity" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating mb-3">
                                <input asp-for="StartDate" class="form-control" type="date" />
                                <label asp-for="StartDate"></label>
                                <span asp-for="StartDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating mb-3">
                                <input asp-for="EndDate" class="form-control" type="date" />
                                <label asp-for="EndDate"></label>
                                <span asp-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success flex-grow-1">Create Course</button>
                        <a asp-controller="Dashboard" asp-action="Instructor" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
