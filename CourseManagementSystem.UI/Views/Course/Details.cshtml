@model CourseViewModel
@{
    ViewData["Title"] = Model.Name;
    bool isInstructor = ViewBag.IsInstructor ?? false;
    bool isStudent = ViewBag.IsStudent ?? false;
    var students = ViewBag.Students as List<UserViewModel>;
}

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm mb-4">
            @if (!string.IsNullOrEmpty(Model.CourseImageUrl))
            {
                <img src="@Model.CourseImageUrl" class="card-img-top" alt="@Model.Name">
            }
            else
            {
                <div class="bg-light text-center py-5 border-bottom">
                    <i class="bi bi-book display-1 text-muted"></i>
                </div>
            }
            <div class="card-body">
                <h4 class="card-title">@Model.Name</h4>
                <p class="text-muted">@Model.Code</p>
                <hr />
                <p><strong>Instructor:</strong> @Model.InstructorName</p>
                <p><strong>Capacity:</strong> @Model.EnrolledCount / @Model.Capacity</p>
                <p><strong>Start Date:</strong> @Model.StartDate</p>
                <p><strong>End Date:</strong> @Model.EndDate</p>
                
                @if (isInstructor)
                {
                    <hr />
                    <div class="alert alert-secondary small py-1">
                        Debug: UserID @(ViewBag.User?.Id), Role @(ViewBag.User?.Role), CourseOwner @(Model.InstructorId)
                    </div>
                    <h5>Instructor Actions</h5>
                    
                    @if (TempData["InviteCode"] != null)
                    {
                        <div class="alert alert-info">
                            <strong>Invite Code:</strong> @TempData["InviteCode"]
                        </div>
                    }

                    <form asp-action="GenerateCode" method="post" class="mb-3">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-info w-100">Generate Invite Code</button>
                    </form>

                    <button class="btn btn-outline-primary w-100 mb-2" data-bs-toggle="modal" data-bs-target="#uploadImageModal">Change Image</button>
                    <button class="btn btn-outline-success w-100 mb-2" data-bs-toggle="modal" data-bs-target="#uploadMaterialModal">Upload Material</button>
                    
                    <hr />
                    <button class="btn btn-danger w-100" data-bs-toggle="modal" data-bs-target="#deleteCourseModal">Delete Course</button>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0">Description</h5>
            </div>
            <div class="card-body">
                <p>@Model.Description</p>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0">Course Materials & Assignments</h5>
            </div>
            <div class="card-body">
                @{
                    var files = ViewBag.Files as List<FileAttachmentViewModel> ?? new List<FileAttachmentViewModel>();
                }
                @if (files.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var file in files)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="bi bi-file-earmark-pdf text-danger me-2"></i>
                                    <strong>@file.Filename</strong>
                                    <span class="badge bg-secondary ms-2">@file.Subtype</span>
                                    <br />
                                    <small class="text-muted">@file.HumanReadableSize | Uploaded: @file.CreatedAt</small>
                                </div>
                                <a asp-action="Download" asp-route-fileId="@file.Id" 
                                   class="btn btn-sm btn-outline-primary" target="_blank">
                                    <i class="bi bi-download"></i> Download
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No materials uploaded yet.</p>
                }
            </div>
        </div>

        @if (isInstructor && students != null)
        {
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Enrolled Students</h5>
                    <span class="badge bg-primary">@students.Count</span>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Enrolled Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in students)
                                {
                                    <tr>
                                        <td>@student.FullName</td>
                                        <td>@student.Email</td>
                                        <td>@student.CreatedAt</td>
                                        <td>
                                            <form asp-action="KickStudent" method="post" onsubmit="return confirm('Are you sure you want to kick this student?');">
                                                <input type="hidden" name="courseId" value="@Model.Id" />
                                                <input type="hidden" name="studentId" value="@student.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm">Kick</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Delete Course Modal -->
<div class="modal fade" id="deleteCourseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">Delete Course</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the course <strong>@Model.Name</strong>?</p>
                    <p class="text-danger small">This action is permanent and will remove all enrollments and materials.</p>
                    <input type="hidden" name="id" value="@Model.Id" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete Permanently</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Upload Image Modal -->
<div class="modal fade" id="uploadImageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UploadImage" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title">Upload Course Image</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="courseId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Select Image</label>
                        <input type="file" name="file" class="form-control" accept="image/*" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Upload Material Modal -->
<div class="modal fade" id="uploadMaterialModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UploadMaterial" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title">Upload Material (PDF)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="courseId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Material Type</label>
                        <select name="subtype" class="form-select">
                            <option value="resource">Resource</option>
                            <option value="assignment">Assignment</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Select PDF</label>
                        <input type="file" name="file" class="form-control" accept=".pdf" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>
